{
  "name": "shia-ai",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "شیعہ اے آئی (Shia AI) — authentic Urdu answers grounded in Thaqalayn hadith data and sistani.org fatawa",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "fonts": "node scripts/build-fonts.mjs",
    "build:data": "node scripts/build-hadith-index.mjs && node scripts/build-fatawa-index.mjs && node scripts/build-search-index.mjs",
    "build:hadith": "node scripts/build-hadith-index.mjs",
    "build:fatawa": "node scripts/build-fatawa-index.mjs",
    "test": "node scripts/self-test.mjs && node scripts/smoke.mjs",
    "test:unit": "node scripts/self-test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "bash scripts/build-apk.sh debug",
    "apk:release": "bash scripts/build-apk.sh release",
    "apk:ci": "bash scripts/build-apk.sh ci",
    "build:index": "node scripts/build-search-index.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "vite": "^5.4.11",
    "jsdom": "^25.0.1"
  }
}
